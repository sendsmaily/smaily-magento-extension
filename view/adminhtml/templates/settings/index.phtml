<?= $block->getChildHtml('panel.js') ?>
<script>
require(['jquery'], function ($) {
    'use strict';

    var panels = window.smailyPanelsInit($);
    // Strings are translated server-side — see panel/panels-js.phtml.

    // tab id -> savestep step name.
    var steps = {
        connection: 'connect',
        subscribers: 'subscribers',
        automations: 'automations',
        intelligence: 'intelligence',
        rss: 'rss'
    };
    var active = 'connection';
    var workflowsLoaded = false;

    function activate(tab, updateUrl) {
        if (!steps[tab]) {
            tab = 'connection';
        }
        active = tab;
        $('.smaily-tabs li').each(function () {
            $(this).toggleClass('active', $(this).data('tab') === tab);
        });
        $('.smaily-tab-panel').removeClass('active')
            .filter('[data-tab=' + tab + ']').addClass('active');
        if (tab === 'automations' && !workflowsLoaded) {
            workflowsLoaded = true;
            // A workflow-list error shows beside the tab's Save (PRO-3641).
            panels.loadWorkflows('#smaily-w-automations-result');
        }
        if (updateUrl && window.history && window.history.replaceState) {
            var url = new URL(window.location.href);
            url.searchParams.set('tab', tab);
            window.history.replaceState(null, '', url.toString());
        }
    }

    panels.initAll();

    // Website selector (RFC_MULTI_WEBSITE.md §2): reloads the page with
    // ?website=<id>, keeping the current tab — every save/prefill path reads
    // its target website server-side, so a plain reload is the whole
    // mechanism, no client-side state to carry.
    $('#smaily-website-select-input').on('change', function () {
        var url = new URL(window.location.href);
        url.searchParams.set('website', $(this).val());
        url.searchParams.set('tab', active);
        window.location.href = url.toString();
    });

    $('.smaily-tabs').on('click', 'li', function () {
        activate($(this).data('tab'), true);
    });

    // Shared by every tab's own Save button — the same per-tab AJAX save,
    // each with its own status. Every tab has its own footer, so there is no
    // page-wide Save (PRO-3641). A failed save shows the error banner above
    // the tab's form and marks the field that caused it; the status beside
    // the button says the save failed (PRO-3562).
    function saveTab($button, step, resultSelector) {
        var $panel = $('.smaily-tab-panel.active');
        $button.prop('disabled', true);
        panels.clearFormErrors($panel);
        panels.result(resultSelector, '<?= $escaper->escapeJs(__('Saving…')) ?>', true);
        new Promise(function (resolve) { resolve(panels.collect[step]()); })
            .then(function (data) { return panels.saveStep(step, data); })
            .then(function (response) {
                // A changed storefront address reaches Campaign Intelligence
                // with the next catalog import (PRO-3660).
                panels.result(resultSelector, response && response.storefrontUrlChanged
                    ? '<?= $escaper->escapeJs(__('Saved. Run the catalog import again under Intelligence > Historical imports, so that Campaign Intelligence gets the new product links.')) ?>'
                    : '<?= $escaper->escapeJs(__('Saved.')) ?>', true);
            })
            .catch(function (error) {
                panels.showFormErrors($panel, error);
                panels.result(resultSelector, '<?= $escaper->escapeJs(__('Saving failed.')) ?>', false);
            })
            .finally(function () {
                $button.prop('disabled', false);
            });
    }

    $('#smaily-w-connection-save').on('click', function () {
        saveTab($(this), 'connect', '#smaily-w-test-result');
    });

    $('#smaily-w-subscribers-save').on('click', function () {
        saveTab($(this), 'subscribers', '#smaily-w-subscribers-result');
    });

    $('#smaily-w-automations-save').on('click', function () {
        saveTab($(this), 'automations', '#smaily-w-automations-result');
    });

    $('#smaily-w-rss-save').on('click', function () {
        saveTab($(this), 'rss', '#smaily-w-rss-result');
    });

    $('#smaily-w-intelligence-save').on('click', function () {
        saveTab($(this), 'intelligence', '#smaily-w-intelligence-result');
    });

    // Live reactivity across tabs: edited credentials re-render the
    // dependent workflow dropdowns (Automations tab) without saving.
    var credentialTimer = null;
    $('#smaily-w-subdomain, #smaily-w-username, #smaily-w-password').on('input', function () {
        clearTimeout(credentialTimer);
        credentialTimer = setTimeout(function () {
            workflowsLoaded = true;
            panels.loadWorkflows(null);
        }, 1200);
    });

    activate(new URLSearchParams(window.location.search).get('tab') || 'connection', false);
});
</script>
