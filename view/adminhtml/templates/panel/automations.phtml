<?php
/**
 * Copyright © Smaily. All rights reserved.
 * See LICENSE.txt for license details.
 *
 * Store-event automations panel — shared by the setup wizard (step 3) and the
 * Settings page (Automations tab, where the engine-run automations block
 * renders below it). Behavior lives in panel/panels-js.phtml.
 *
 * Each trigger is a card (name + run-mode pill + description + right-aligned
 * control row), not a dense checkbox+dropdown table (PRO-1357 finding #9). The
 * workflow select is disabled while the trigger is off; the pill follows the
 * enable toggle live.
 *
 * In multilingual modes A/B a per-language workflow mapping editor renders
 * below the trigger cards: one table per trigger with a workflow select per
 * language and a default-fallback radio (Woo parity). The editor shows/hides
 * live when the mode cards on the Connection panel change. In mode A it names
 * the languages a switched-on automation has no workflow for (CON-188).
 *
 * Each card has a "Send a discount code" switch (CON-198): a cart price rule
 * picker, listing the rules that can generate codes, and the days a code is
 * valid. Without such a rule it says how to make one in Magento.
 *
 * @var \Magento\Backend\Block\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

/** @var \Smaily\Connect\ViewModel\Adminhtml\WizardData $viewModel */
$viewModel = $block->getData('view_model');
$isMultilingual = $viewModel->isMultilingual();
$languages = $viewModel->getDetectedLanguages();
$mode = $viewModel->getMultilingualMode();
// Each per-language mode keeps its own rows, for the accounts it sends
// through (CON-184); a live switch between the mode cards shows the next
// mode's rows (panels-js.phtml).
$savedByMode = [
    'a' => $viewModel->getSavedMappings('a'),
    'b' => $viewModel->getSavedMappings('b'),
];
$savedMappings = $savedByMode[$mode] ?? [];
$showMapping = $isMultilingual && ($mode === 'a' || $mode === 'b');

$triggers = [
    'welcome' => __('Welcome'),
    'first_order' => __('First order'),
    'abandoned_cart' => __('Abandoned cart'),
];
// Each mapping trigger's Enabled switch on its card below.
$switchIds = ['welcome' => 'welcome', 'first_order' => 'firstorder', 'abandoned_cart' => 'abandoned'];
// The cart price rules a discount code can come from (CON-198).
$discountRules = $viewModel->getDiscountRules();
$hasCartPriceRules = $discountRules === [] && $viewModel->hasCartPriceRules();

// Store-event trigger cards. The id slug differs from the trigger key
// (first_order -> firstorder, abandoned_cart -> abandoned) to match the
// element ids panel/panels-js.phtml already binds; names reuse $triggers.
$storeTriggers = [
    ['id' => 'welcome', 'name' => $triggers['welcome'], 'desc' => __('Fires when a shopper subscribes to the newsletter in your store.')],
    ['id' => 'firstorder', 'name' => $triggers['first_order'], 'desc' => __('Fires on a customer\'s first purchase.')],
    ['id' => 'abandoned', 'name' => $triggers['abandoned_cart'], 'desc' => __('Fires when a cart is left behind.'), 'abandoned' => true],
];
?>
<div class="smaily-card">
    <?php // The initial setup shows this title above the card (wizard/index.phtml, PRO-3561). ?>
    <?php if ($block->getData('context') !== 'wizard'): ?>
    <h2><?= $escaper->escapeHtml(__('Map store events to Smaily automations')) ?></h2>
    <?php endif; ?>
    <p><?= $escaper->escapeHtml(__('Each event triggers the Smaily automation workflow you pick. The lists below come live from your Smaily account — create the workflows there first if they are missing, then press Refresh.')) ?>
       <button type="button" class="action-tertiary" id="smaily-w-refresh-workflows"><span><?= $escaper->escapeHtml(__('Refresh workflows')) ?></span></button>
    </p>

    <div class="smaily-engine-triggers smaily-store-triggers">
        <?php foreach ($storeTriggers as $trigger): ?>
        <?php $id = $escaper->escapeHtmlAttr($trigger['id']); ?>
        <div class="smaily-engine-trigger smaily-store-trigger is-off">
            <div class="smaily-engine-trigger__top">
                <div class="smaily-engine-trigger__head">
                    <div class="smaily-engine-trigger__name-row">
                        <span class="smaily-engine-trigger__name"><?= $escaper->escapeHtml($trigger['name']) ?></span>
                        <span class="smaily-pill smaily-pill--off smaily-store-pill"><span class="smaily-pill__dot"></span><span class="smaily-store-pill__text"><?= $escaper->escapeHtml(__('Off')) ?></span></span>
                    </div>
                    <div class="smaily-engine-trigger__desc"><?= $escaper->escapeHtml($trigger['desc']) ?></div>
                    <div class="smaily-engine-trigger__controls smaily-store-trigger__enable">
                        <span class="smaily-engine-trigger__ctrl"><label><input type="checkbox" id="smaily-w-<?= /* @noEscape */ $id ?>-enabled"/> <?= $escaper->escapeHtml(__('Enabled')) ?></label></span>
                    </div>
                </div>
                <div class="smaily-engine-trigger__controls">
                    <label class="smaily-engine-trigger__ctrl">
                        <span><?= $escaper->escapeHtml(__('Smaily Workflow')) ?></span>
                        <select id="smaily-w-<?= /* @noEscape */ $id ?>-workflow" class="smaily-w-workflow"></select>
                    </label>
                    <?php if (!empty($trigger['abandoned'])): ?>
                    <label class="smaily-engine-trigger__ctrl">
                        <span><?= $escaper->escapeHtml(__('Wait (minutes)')) ?></span>
                        <input type="number" id="smaily-w-cutoff" min="10" max="1440" value="30"/>
                    </label>
                    <?php endif; ?>
                </div>
            </div>
            <?php // The automation's discount code (CON-198); panels-js.phtml shows the fields while the switch is on. ?>
            <div class="smaily-store-discount">
                <label class="smaily-store-discount__switch"><input type="checkbox" id="smaily-w-<?= /* @noEscape */ $id ?>-coupon-enabled" class="smaily-w-coupon-enabled"/> <?= $escaper->escapeHtml(__('Send a discount code')) ?></label>
                <div class="smaily-store-discount__body" id="smaily-w-<?= /* @noEscape */ $id ?>-coupon" style="display:none;">
                    <div class="smaily-engine-trigger__controls">
                        <label class="smaily-engine-trigger__ctrl">
                            <span><?= $escaper->escapeHtml(__('Cart price rule')) ?></span>
                            <select id="smaily-w-<?= /* @noEscape */ $id ?>-coupon-rule" class="smaily-w-coupon-rule">
                                <option value=""><?= $escaper->escapeHtml(__('Pick a rule')) ?></option>
                                <?php foreach ($discountRules as $ruleId => $ruleName): ?>
                                <option value="<?= (int)$ruleId ?>"><?= $escaper->escapeHtml($ruleName) ?></option>
                                <?php endforeach; ?>
                            </select>
                        </label>
                        <label class="smaily-engine-trigger__ctrl">
                            <span><?= $escaper->escapeHtml(__('Valid for (days)')) ?></span>
                            <input type="number" id="smaily-w-<?= /* @noEscape */ $id ?>-coupon-days" class="smaily-w-coupon-days" min="1" max="365" value="7"/>
                        </label>
                    </div>
                    <p class="note"><?= $escaper->escapeHtml(__('The discount\'s percentage or amount, its conditions and its dates come from the cart price rule you pick. The extension only makes each shopper\'s own single-use code from it.')) ?></p>
                    <p class="note"><?= $escaper->escapeHtml(__('A code works until the end of the day that many days after the email, and never after the rule\'s To date.')) ?></p>
                    <?php if ($discountRules === []): ?>
                    <div class="smaily-banner smaily-banner--info smaily-w-coupon-empty">
                        <div class="smaily-banner__body">
                            <div class="smaily-banner__title"><?= $escaper->escapeHtml(__('Make the discount in Magento first')) ?></div>
                            <div class="smaily-banner__message"><?= $escaper->escapeHtml(__('The codes come from one of your cart price rules. In Marketing > Cart Price Rules > Add New Rule, set Coupon to "Specific Coupon", tick "Use Auto Generation" and save the rule. Then reload this page: the rule appears in the list.')) ?></div>
                            <?php if ($hasCartPriceRules): ?>
                            <div class="smaily-banner__message smaily-w-coupon-why"><?= $escaper->escapeHtml(__('Your cart price rules are not listed: a rule is listed only when it is active for these websites and has Coupon "Specific Coupon" with "Use Auto Generation" ticked.')) ?></div>
                            <?php endif; ?>
                            <div class="smaily-banner__message"><a href="<?= $escaper->escapeUrl($block->getUrl('sales_rule/promo_quote/new')) ?>" target="_blank" rel="noopener"><?= $escaper->escapeHtml(__('Add a cart price rule')) ?></a></div>
                        </div>
                    </div>
                    <?php endif; ?>
                </div>
            </div>
        </div>
        <?php endforeach; ?>
    </div>

    <p class="note"><?= $escaper->escapeHtml(__('How long a cart must be inactive before it counts as abandoned. Minimum 10 minutes. Carts older than 24 hours are never mailed.')) ?></p>
    <p class="note"><?= $escaper->escapeHtml(__('If another tool also sends abandoned-cart emails (for example an extension such as Mageplaza SMTP or Avada Email Marketing, or Adobe Commerce\'s own email reminder rules), switch those emails off there, so a shopper does not get two reminders for one cart.')) ?></p>
    <p class="note"><?= $escaper->escapeHtml(__('The automation receives the cart contents (up to 10 products) and a recovery link that restores the exact cart.')) ?>
    <?php if ($isMultilingual): ?>
        <span id="smaily-ml-mapping-off" <?= $showMapping ? 'style="display:none;"' : '' ?>>
            <?= $escaper->escapeHtml(__('Want a different workflow per language? Pick a per-language mode on the Connection panel.')) ?>
        </span>
    <?php endif; ?>
    </p>
</div>

<?php if ($isMultilingual): ?>
<div class="smaily-card" id="smaily-ml-mapping" <?= $showMapping ? '' : 'style="display:none;"' ?>>
    <h2><?= $escaper->escapeHtml(__('Per-language workflows')) ?></h2>
    <p class="note smaily-ml-hint-a" <?= $mode === 'a' ? '' : 'style="display:none;"' ?>>
        <?= $escaper->escapeHtml(__('Each language row lists the workflows of that language\'s own Smaily account (Connection panel) and fires through it.')) ?>
    </p>
    <p class="note smaily-ml-hint-b" <?= $mode === 'b' ? '' : 'style="display:none;"' ?>>
        <?= $escaper->escapeHtml(__('All languages share one Smaily account; each language fires its own workflow from the list.')) ?>
    </p>
    <p class="note smaily-ml-hint-b" <?= $mode === 'b' ? '' : 'style="display:none;"' ?>><?= $escaper->escapeHtml(__('The default fallback handles contacts whose language is not mapped. Leave it on "None" to fall back to the default workflow above.')) ?></p>
    <?php // Mode A never starts the default workflow above: it was picked from no per-language account (CON-188). ?>
    <p class="note smaily-ml-hint-a" <?= $mode === 'a' ? '' : 'style="display:none;"' ?>><?= $escaper->escapeHtml(__('The default fallback handles contacts whose language has no workflow. Leave it on "None" to use the workflow of the default fallback account\'s language (Connection panel). With neither, these contacts get no automation.')) ?></p>
    <?php // Filled live by panels-js.phtml (showUnmappedLanguages()) in mode A. ?>
    <div class="smaily-banner smaily-banner--warning" id="smaily-ml-unmapped" style="display:none;">
        <span class="smaily-banner__icon">&#9888;</span>
        <div class="smaily-banner__body">
            <div class="smaily-banner__title"><?= $escaper->escapeHtml(__('Some languages have no workflow')) ?></div>
            <div class="smaily-banner__message"><?= $escaper->escapeHtml(__('Contacts in these languages get no automation. Pick a workflow for them, or a default fallback.')) ?></div>
            <ul class="smaily-banner__message smaily-ml-unmapped-list"></ul>
        </div>
    </div>

    <?php foreach ($triggers as $triggerType => $triggerLabel): ?>
    <?php
    $fallbackByMode = [];
    foreach ($savedByMode as $savedMode => $rows) {
        $fallbackByMode[$savedMode] = '';
        foreach ($languages as $language) {
            if ($rows[$triggerType . '|' . $language]['isDefaultFallback'] ?? false) {
                $fallbackByMode[$savedMode] = $language;
            }
        }
    }
    ?>
    <div class="smaily-field smaily-ml-trigger" data-trigger="<?= $escaper->escapeHtmlAttr($triggerType) ?>"
         data-switch="smaily-w-<?= $escaper->escapeHtmlAttr($switchIds[$triggerType]) ?>-enabled"
         data-fallback-a="<?= $escaper->escapeHtmlAttr($fallbackByMode['a']) ?>"
         data-fallback-b="<?= $escaper->escapeHtmlAttr($fallbackByMode['b']) ?>"
         data-unlisted-fallback-a="<?= ($savedByMode['a'][$triggerType . '|default']['isDefaultFallback'] ?? false) ? '1' : '' ?>">
        <label><?= $escaper->escapeHtml($triggerLabel) ?></label>
        <table class="smaily-ml-table">
            <thead>
                <tr>
                    <th><?= $escaper->escapeHtml(__('Language')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Workflow')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Default fallback')) ?></th>
                </tr>
            </thead>
            <tbody>
                <?php $savedFallback = ''; ?>
                <?php foreach ($languages as $language): ?>
                <?php
                $saved = $savedMappings[$triggerType . '|' . $language] ?? null;
                if ($saved !== null && $saved['isDefaultFallback']) {
                    $savedFallback = $language;
                }
                ?>
                <tr>
                    <td><?= $escaper->escapeHtml(strtoupper($language)) ?></td>
                    <td>
                        <select class="smaily-ml-workflow"
                                data-trigger="<?= $escaper->escapeHtmlAttr($triggerType) ?>"
                                data-language="<?= $escaper->escapeHtmlAttr($language) ?>"
                                data-saved="<?= $escaper->escapeHtmlAttr((string)($saved['workflowId'] ?? '')) ?>"
                                data-saved-a="<?= $escaper->escapeHtmlAttr((string)($savedByMode['a'][$triggerType . '|' . $language]['workflowId'] ?? '')) ?>"
                                data-saved-b="<?= $escaper->escapeHtmlAttr((string)($savedByMode['b'][$triggerType . '|' . $language]['workflowId'] ?? '')) ?>"></select>
                    </td>
                    <td>
                        <input type="radio"
                               name="smaily-ml-fallback-<?= $escaper->escapeHtmlAttr($triggerType) ?>"
                               value="<?= $escaper->escapeHtmlAttr($language) ?>"
                               <?= ($savedMappings[$triggerType . '|' . $language]['isDefaultFallback'] ?? false) ? 'checked' : '' ?>/>
                    </td>
                </tr>
                <?php endforeach; ?>
                <tr>
                    <td colspan="2" class="smaily-ml-none">
                        <span class="smaily-ml-hint-b" <?= $mode === 'b' ? '' : 'style="display:none;"' ?>><?= $escaper->escapeHtml(__('None (use the default workflow above)')) ?></span>
                        <span class="smaily-ml-hint-a" <?= $mode === 'a' ? '' : 'style="display:none;"' ?>><?= $escaper->escapeHtml(__('None (use the default fallback account\'s language)')) ?></span>
                    </td>
                    <td>
                        <input type="radio"
                               name="smaily-ml-fallback-<?= $escaper->escapeHtmlAttr($triggerType) ?>"
                               value=""
                               <?= $savedFallback === '' ? 'checked' : '' ?>/>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <?php endforeach; ?>
</div>
<?php endif; ?>
