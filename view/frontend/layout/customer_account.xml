<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="Smaily\Connect\Block\Account\PersonalizationLink"
                   name="smaily-privacy-link">
                <arguments>
                    <argument name="path" xsi:type="string">smaily/privacy</argument>
                    <argument name="label" xsi:type="string" translate="true">Personalization</argument>
