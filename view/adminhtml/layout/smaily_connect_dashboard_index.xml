<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Smaily_Connect::css/smaily-admin.css"/>
    </head>
    <body>
        <!-- The Smaily Connect logo above the page title (CON-372); the
             Dashboard, the extension's landing page, plays its entrance. -->
        <referenceContainer name="main.top">
            <block class="Magento\Backend\Block\Template"
                   name="smaily.brand"
                   template="Smaily_Connect::brand.phtml"
                   before="page.title">
                <arguments>
                    <argument name="entrance" xsi:type="boolean">true</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template"
                   name="smaily.dashboard"
                   template="Smaily_Connect::dashboard/index.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Smaily\Connect\ViewModel\Adminhtml\DashboardData</argument>
                </arguments>
                <block class="Magento\Backend\Block\Template"
                       name="smaily.invitation.banner" as="invitation.banner"
                       template="Smaily_Connect::panel/smaily-invitation-banner.phtml">
                    <arguments>
                        <argument name="view_model" xsi:type="object">Smaily\Connect\ViewModel\Adminhtml\SmailyInvitationData</argument>
                        <argument name="dismissible" xsi:type="boolean">true</argument>
                    </arguments>
                </block>
                <!-- The Dashboard needs only Smaily_Connect::connect; the
                     Campaign Intelligence banner and its start are for
                     admins who may open the Settings. -->
                <block class="Magento\Backend\Block\Template"
                       name="smaily.intelligence.banner.top" as="intelligence.banner.top"
                       template="Smaily_Connect::panel/intelligence-banner.phtml"
                       aclResource="Smaily_Connect::config">
                    <arguments>
                        <argument name="view_model" xsi:type="object">Smaily\Connect\ViewModel\Adminhtml\IntelligenceBannerData</argument>
                        <argument name="dismissible" xsi:type="boolean">true</argument>
                    </arguments>
                </block>
                <block class="Magento\Backend\Block\Template"
                       name="smaily.intelligence.start" as="intelligence.start"
                       template="Smaily_Connect::panel/intelligence-start.phtml"
                       aclResource="Smaily_Connect::config">
                    <arguments>
                        <argument name="view_model" xsi:type="object">Smaily\Connect\ViewModel\Adminhtml\IntelligenceBannerData</argument>
                        <argument name="dismissible" xsi:type="boolean">true</argument>
                    </arguments>
                </block>
            </block>
            <block class="Magento\Backend\Block\Template"
                   name="smaily.version"
                   template="Smaily_Connect::version.phtml"
                   after="-"/>
        </referenceContainer>
    </body>
</page>
