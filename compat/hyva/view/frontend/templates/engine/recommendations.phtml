 *
 * Hyvä variant of the recommendations bootstrap. Same pattern as the
 * tracker template: inert JSON config + a static same-origin JS file, no
 * inline executable script (strict-CSP-safe). The script does nothing on a
 * page without the "Smaily recommendations" widget's container. It is
 * emitted after the attribution script (layout order in the base module's
 * default.xml; `defer` keeps document order), so window.smailyConsent is
 * available when it runs.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

/** @var \Smaily\Connect\ViewModel\EngineState $viewModel */
$viewModel = $block->getData('view_model');
if (!$viewModel->isRecommendationsActive()) {
    return;
}
?>
<script type="application/json" id="smaily-recommendations-config">
    <?= /* @noEscape */ $viewModel->getRecommendationsConfigJson() ?>
</script>
<script defer
        src="<?= $escaper->escapeUrl($block->getViewFileUrl('Hyva_SmailyConnect::js/smaily-recommendations.js')) ?>">
</script>
